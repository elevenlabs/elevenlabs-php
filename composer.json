{
  "name": "elevenlabs/elevenlabs-php",
  "description": "ElevenLabs PHP Library",
  "keywords": [
    "elevenlabs",
    "api",
    "sdk"
  ],
  "support": {
    "source": "https://github.com/elevenlabs/elevenlabs-php"
  },
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.0",
    "php-http/multipart-stream-builder": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "ext-json": "*",
    "phrity/websocket": "^3.8 || ^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "laravel/pint": "^1.13.7",
    "phpstan/phpstan": "^1.12",
    "nyholm/psr7": "^1.8",
    "guzzlehttp/guzzle": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "ElevenLabs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ElevenLabs\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": [
      "./vendor/bin/pint"
    ],
    "build": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "test": [
      "./vendor/bin/phpunit --testdox"
    ],
    "analyze": "phpstan analyze src tests --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
