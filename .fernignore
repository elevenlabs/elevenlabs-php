# Specify files that shouldn't be modified by Fern

README.md

# Hand-written webhook signature verifier (Fern's generated verifier can't parse
# the compound `t=...,v0=...` header).
src/Webhooks/WebhookVerifier.php
tests/Webhooks/WebhookVerifierTest.php

# Hand-written agent workflows-as-code builder (a layer on top of the generated
# client; emits the generated workflow request type or canonical wire JSON).
# Conformance fixtures are shared across every SDK.
src/AgentWorkflows/
tests/AgentWorkflows/
tests/fixtures/agent_workflows/

# Hand-written Speech Engine server model (dev hosts a WebSocket server that the
# ElevenLabs API dials into). The generator produces only the client-dials-out
# upstream socket; these add the inbound-connection JWT verifier, per-connection
# session/protocol, the standalone phrity-based server, and the engine resource.
src/SpeechEngine/SpeechEngineJwtVerifier.php
tests/SpeechEngine/SpeechEngineJwtVerifierTest.php
src/SpeechEngine/ConversationMessage.php
src/SpeechEngine/SpeechEngineSession.php
src/SpeechEngine/SpeechEngineServer.php
src/SpeechEngine/SpeechEngineResource.php
tests/SpeechEngine/SpeechEngineSessionTest.php
tests/SpeechEngine/SpeechEngineResourceTest.php

# Hand-written Flows `createAndWait` helpers (start a generation or template run and poll until it
# finishes). The generated methods return only the body, and the wait needs the `Retry-After`
# header, so these send through the generated services' own request path. A separate entry point
# (`FlowsWaiter`) because the root client and the flows clients are regenerated.
src/Flows/Wait/
tests/Flows/Wait/
